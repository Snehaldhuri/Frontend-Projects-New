<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.guestservice.concierge.laundry.LaundryFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_laundry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_35"
        android:layout_marginEnd="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lv_laundry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_20"
        android:divider="@null"
        android:fadeScrollbars="false"
        android:focusable="true"
        android:nextFocusDown="@+id/lv_laundry"
        android:scrollbars="vertical"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guideline_70"
        app:layout_constraintStart_toStartOf="@id/guideline_35"
        android:layout_marginStart="4dp"/>


    <Button
        android:id="@+id/btn_laundry_cancel"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_marginStart="@dimen/dp_20"
        android:background="@drawable/btn_bg_gradient_default"
        android:drawableEnd="@drawable/back_image"
        android:drawablePadding="@dimen/dp_50"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusRight="@id/btn_send_request"
        android:text="@string/Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_laundry_send_request"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/guideline_35" />

    <Button
        android:id="@+id/btn_laundry_send_request"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_bg_gradient_default"
        android:drawableEnd="@drawable/forward_image"
        android:drawablePadding="@dimen/dp_50"
        android:layout_marginEnd="@dimen/dp_20"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/send_request"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_laundry_cancel" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_35"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_70"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />

</androidx.constraintlayout.widget.ConstraintLayout>
