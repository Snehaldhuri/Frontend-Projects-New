<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.guestservice.concierge.laundry.LaundryFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_laundry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lv_laundry"
        android:layout_width="450dp"
        android:layout_height="200dp"
        android:layout_marginLeft="@dimen/dp_20"
        android:divider="@null"
        android:fadeScrollbars="false"
        android:focusable="true"
        android:nextFocusDown="@+id/lv_laundry"
        android:scrollbars="vertical"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btn_laundry_cancel"
        android:layout_width="150dp"
        android:layout_height="@dimen/dp_30"
        android:layout_marginTop="50dp"
        android:layout_marginRight="@dimen/dp_50"
        android:background="@drawable/btn_bg_gradient_default"
        android:text="@string/Cancel"
        android:textSize="@dimen/sp_10"
        app:layout_constraintEnd_toStartOf="@+id/btn_laundry_send_request"
        app:layout_constraintTop_toBottomOf="@+id/lv_laundry" />

    <Button
        android:id="@+id/btn_laundry_send_request"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/dp_50"
        android:layout_marginEnd="44dp"
        android:background="@drawable/btn_bg_gradient_default"
        android:text="Send Request"
        android:textSize="@dimen/sp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lv_laundry" />


</androidx.constraintlayout.widget.ConstraintLayout>