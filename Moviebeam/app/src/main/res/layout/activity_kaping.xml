<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stb_dark_landing_page"
    tools:context=".ui.kaping.RegisterSTBActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_35"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_65"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.65" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_95"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_23"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.23" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_60"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6" />

    <ImageView
        android:id="@+id/iv_mb_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_10"
        android:contentDescription="@string/moviebeam_logo"
        android:src="@drawable/moviebeam_logo_header"
        app:layout_constraintDimensionRatio="6.1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.6" />

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_10"
        app:cardBackgroundColor="@color/semiOpaqueBlackColor"
        app:cardCornerRadius="@dimen/dp_8"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="@id/gl_horizontal_60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gl_horizontal_23" />

    <TextView
        android:id="@+id/tv_stb_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/stb_registered"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_5"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_25" />

    <TextView
        android:id="@+id/tv_stb"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/pending"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_35"
        app:layout_constraintStart_toEndOf="@+id/tv_stb_title"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_25" />

    <TextView
        android:id="@+id/tv_ua_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/ua"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_5"
        app:layout_constraintTop_toBottomOf="@+id/tv_stb_title" />

    <TextView
        android:id="@+id/tv_ua"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_35"
        app:layout_constraintStart_toEndOf="@id/tv_ua_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_stb_title" />

    <TextView
        android:id="@+id/tv_serial_no_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/serial_no"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_5"
        app:layout_constraintTop_toBottomOf="@+id/tv_ua_title" />

    <TextView
        android:id="@+id/tv_serial_no"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_35"
        app:layout_constraintStart_toEndOf="@id/tv_serial_no_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_ua_title" />

    <ImageView
        android:id="@+id/iv_qr_code"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:contentDescription="@string/qr_code"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@id/gl_vertical_5"
        app:layout_constraintTop_toBottomOf="@+id/tv_serial_no_title"
        app:layout_constraintWidth_percent="0.05" />

    <TextView
        android:id="@+id/tv_ip_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/ip_address"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_35"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_25" />

    <TextView
        android:id="@+id/tv_ip"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toStartOf="@+id/gl_vertical_65"
        app:layout_constraintStart_toEndOf="@+id/tv_ip_title"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_25" />

    <TextView
        android:id="@+id/tv_net_mask_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/net_mask"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toEndOf="@id/gl_vertical_35"
        app:layout_constraintTop_toBottomOf="@+id/tv_ip_title" />

    <TextView
        android:id="@+id/tv_net_mask"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toStartOf="@+id/gl_vertical_65"
        app:layout_constraintStart_toEndOf="@id/tv_net_mask_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_ip_title" />

    <TextView
        android:id="@+id/tv_gateway_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/gateway"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toEndOf="@id/gl_vertical_35"
        app:layout_constraintTop_toBottomOf="@+id/tv_net_mask_title" />

    <TextView
        android:id="@+id/tv_gateway"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toStartOf="@+id/gl_vertical_65"
        app:layout_constraintStart_toEndOf="@id/tv_gateway_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_net_mask_title" />

    <TextView
        android:id="@+id/tv_connectivity_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/connectivity"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toEndOf="@id/gl_vertical_35"
        app:layout_constraintTop_toBottomOf="@id/tv_gateway_title" />

    <TextView
        android:id="@+id/tv_connectivity"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toStartOf="@+id/gl_vertical_65"
        app:layout_constraintStart_toEndOf="@+id/tv_connectivity_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_gateway" />

    <TextView
        android:id="@+id/tv_model_name_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/model_name"
        android:textSize="@dimen/sp_15"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/gl_vertical_65"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_25" />

    <TextView
        android:id="@+id/tv_model_name"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_95"
        app:layout_constraintStart_toEndOf="@+id/tv_model_name_title"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_25" />

    <TextView
        android:id="@+id/tv_sw_version_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/app_software_version"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_65"
        app:layout_constraintTop_toBottomOf="@+id/tv_model_name_title" />

    <TextView
        android:id="@+id/tv_sw_version"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/sp_5"
        android:fontFamily="@font/manrope_semibold_600"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_95"
        app:layout_constraintStart_toEndOf="@+id/tv_sw_version_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_model_name_title" />


</androidx.constraintlayout.widget.ConstraintLayout>