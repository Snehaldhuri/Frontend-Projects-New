<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clHomeMenuButton"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    android:layout_margin="@dimen/dp_4"
    android:background="@drawable/btn_bg_gradient_default"
    android:clickable="true"
    android:layout_gravity="center"
    android:focusable="true"
    android:padding="@dimen/dp_8">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_40"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.4" />

    <ImageView
        android:id="@+id/iv_menu_icon"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_8"
        android:contentDescription="@string/menu_button_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/gl_vertical_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_menu_title"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:fontFamily="@font/manrope_bold_700"
        android:textAlignment="viewStart"
        android:textColor="@color/home_menu_title"
        android:textSize="@dimen/sp_17"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_40"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/round_outline_8dp"
        android:clipToOutline="true"
        android:contentDescription="@string/app_icon"
        android:scaleType="centerCrop" />

</androidx.constraintlayout.widget.ConstraintLayout>
