<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.guestservice.feedback.FeedbackFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.15" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_85"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.85" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_85"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_20"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="How satisfied are you with our services ?"
        android:textSize="@dimen/sp_15"
        app:layout_constraintBottom_toTopOf="@+id/iv_star_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_star_1"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:focusable="true"
        android:src="@drawable/selected_feedback_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_star_3"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_15"
        app:layout_constraintTop_toTopOf="@+id/iv_star_3"
        app:layout_constraintWidth_percent="0.15" />

    <ImageView
        android:id="@+id/iv_star_2"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:focusable="true"
        android:src="@drawable/unselected_feedback_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_star_3"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/iv_star_3"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/iv_star_1"
        app:layout_constraintTop_toTopOf="@+id/iv_star_3"
        app:layout_constraintWidth_percent="0.15" />

    <ImageView
        android:id="@+id/iv_star_3"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:focusable="true"
        android:src="@drawable/unselected_feedback_icon"
        app:layout_constraintBottom_toBottomOf="@+id/gl_horizontal_85"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/iv_star_4"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/iv_star_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.15" />

    <ImageView
        android:id="@+id/iv_star_4"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:focusable="true"
        android:src="@drawable/unselected_feedback_icon"
        app:layout_constraintBottom_toBottomOf="@+id/iv_star_3"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_85"
        app:layout_constraintTop_toTopOf="@+id/iv_star_3"
        app:layout_constraintWidth_percent="0.15" />

    <TextView
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:fontFamily="@font/manrope_semibold_600"
        android:text="@string/unacceptable"
        android:textColor="@color/feedback_negative"
        android:textSize="@dimen/sp_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_star_3" />

    <ProgressBar
        android:id="@+id/pb_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>