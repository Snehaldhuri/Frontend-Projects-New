<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tv_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_8"
        android:textSize="@dimen/sp_22"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/dp_12"
        android:textColor="@color/text_color_secondary"
        android:background="@drawable/bg_rounded_corner"
        app:layout_constraintBottom_toTopOf="@+id/gl_horizontal_50"
        app:layout_constraintEnd_toStartOf="@+id/tv_date"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_50" />


    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_8"
        android:textSize="@dimen/sp_22"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/gl_horizontal_50"
        app:layout_constraintEnd_toStartOf="@+id/gl_vertical_50"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_50" />

    <include
        android:id="@+id/time_selector_layout"
        layout="@layout/time_selector_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@id/gl_horizontal_50"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_50"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_50" />

</androidx.constraintlayout.widget.ConstraintLayout>