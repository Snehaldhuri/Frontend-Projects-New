<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clHotelInfo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.hotelinfo.HotelInfoActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1685" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_27"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.27" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_horizontal_94"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.94" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.052" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_29"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.29" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_vertical_95"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <include
        android:id="@+id/layout_header"
        layout="@layout/item_header_layout"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toTopOf="@+id/gl_horizontal_16"
        app:layout_constraintEnd_toStartOf="@+id/gl_vertical_95"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_5"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_hotel_info_header"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusRight="@id/fragment_container_carousel"
        app:layout_constraintBottom_toTopOf="@+id/gl_horizontal_94"
        app:layout_constraintEnd_toEndOf="@id/gl_vertical_29"
        app:layout_constraintStart_toStartOf="@id/gl_vertical_5"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_27" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_bg_gradient_default"
        android:text="@string/back"
        android:textColor="@color/home_menu_title"
        android:drawableStart="@drawable/back_button_image"
        android:drawablePadding="@dimen/dp_10"
        android:fontFamily="@font/manrope_bold_700"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        app:layout_constraintBottom_toTopOf="@+id/gl_horizontal_27"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_5"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_16" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10"
        android:text=""
        android:textColor="@color/text_color_primary"
        android:textSize="@dimen/sp_25"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/btn_back"
        app:layout_constraintStart_toEndOf="@+id/gl_vertical_29" />


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_carousel"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:nextFocusLeft="@id/rv_menu_button"
        app:layout_constraintBottom_toBottomOf="@+id/gl_horizontal_94"
        app:layout_constraintEnd_toEndOf="@+id/gl_vertical_95"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_29"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_27" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_help_info"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/gl_horizontal_94"
        app:layout_constraintEnd_toEndOf="@+id/gl_vertical_95"
        app:layout_constraintStart_toStartOf="@+id/gl_vertical_5"
        app:layout_constraintTop_toTopOf="@+id/gl_horizontal_16" />


    <ProgressBar
        android:id="@+id/pb_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>