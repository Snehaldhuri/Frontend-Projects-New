<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/dp_3"
    android:paddingBottom="3dp"
    android:id="@+id/constraint">


    <TextView
        android:id="@+id/tv_lv_title"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="250dp"
        android:text="title"
        android:textSize="@dimen/sp_10"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@+id/tv_lv_price"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_lv_price"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:text="10.0"
        android:textSize="@dimen/sp_10"
        app:layout_constraintEnd_toStartOf="@+id/ll_cart"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_cart"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_add"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginRight="@dimen/dp_10"
            android:background="@drawable/bg_grey_border_radius"
            android:src="@drawable/baseline_add_24" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#8D6100"
            android:paddingLeft="@dimen/dp_10"
            android:paddingTop="@dimen/dp_2"
            android:paddingRight="10dp"
            android:paddingBottom="@dimen/dp_2"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_10" />

        <ImageView
            android:id="@+id/img_remove"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginLeft="@dimen/dp_10"
            android:src="@drawable/baseline_horizontal_rule_24" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>