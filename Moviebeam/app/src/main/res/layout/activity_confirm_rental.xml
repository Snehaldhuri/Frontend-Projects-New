<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/dp_24"
    android:background="@color/text_color_secondary"
    tools:context=".ui.movies.ConfirmRentalActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_rental"
        android:textSize="@dimen/sp_32"
        android:textStyle="bold"
        android:textColor="@color/white"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_rental"
        android:textSize="@dimen/sp_20"
        android:layout_marginTop="@dimen/dp_32"
        android:textColor="@color/white"
        android:id="@+id/tv_movie_name"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rental_price_confirm"
        android:textSize="@dimen/sp_24"
        android:gravity="center"
        android:textColor="@color/white"
        android:layout_margin="@dimen/dp_4"
        android:id="@+id/tv_price_confirm"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_24"
        >
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_bg_gradient_default"
            android:paddingHorizontal="@dimen/dp_15"
            android:text="Cancel"
            android:drawablePadding="@dimen/dp_16"
            android:drawableStart="@drawable/baseline_arrow_back_ios_new_24"
           />

        <View
            android:layout_width="80dp"
            android:layout_height="0dp"
            />

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_bg_gradient_default"
            android:paddingHorizontal="@dimen/dp_15"
            android:text="Confirm"
            android:drawablePadding="@dimen/dp_16"
            android:drawableEnd="@drawable/baseline_arrow_forward_ios_24"
            />
    </LinearLayout>

</LinearLayout>