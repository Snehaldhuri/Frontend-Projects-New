<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/text_color_secondary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/dp_24"
    tools:context=".ui.movies.ConfirmRentalActivity">

    <LinearLayout
        android:id="@+id/layout_rental"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"

        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_rental"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_movie_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_32"
            android:text="@string/confirm_rental"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20" />

        <TextView
            android:id="@+id/tv_price_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_4"
            android:gravity="center"
            android:text="@string/rental_price_confirm"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_24" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_bg_gradient_default"
                android:drawableStart="@drawable/baseline_arrow_back_ios_new_24"
                android:drawablePadding="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_15"
                android:text="@string/Cancel" />

            <View
                android:layout_width="80dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_bg_gradient_default"
                android:drawableEnd="@drawable/baseline_arrow_forward_ios_24"
                android:drawablePadding="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_15"
                android:text="@string/confirm" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_pass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"

        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchase_adult_day_pass"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_adult_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_20"
            android:gravity="center"
            android:text="@string/adult_pass_price"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_20" />

        <Button
            android:id="@+id/btn_buy_now"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/btn_bg_gradient_default"
            android:drawablePadding="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_15"
            android:text="@string/buy_now"
            android:textAllCaps="false" />


        <Button
            android:id="@+id/btn_pass_cancel"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/btn_bg_gradient_default"
            android:drawablePadding="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_15"
            android:text="@string/Cancel"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_12"
            android:text="@string/adult_daypass_disclaimer"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16" />

    </LinearLayout>

    <ProgressBar
        android:visibility="gone"
        android:id="@+id/progressBar"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:indeterminateTint="@color/white" />

</LinearLayout>